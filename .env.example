# ─── Base de données (Supabase Postgres) ─────────────────────────────────────
# Dashboard Supabase → Project Settings → Database → Connection string
# Utiliser la connexion "Transaction pooler" (port 6543) pour les requêtes app,
# et la connexion "Session" (port 5432) pour les migrations Prisma.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth (NextAuth / Auth.js v5) ────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL canonique de l'app (sans slash final)
AUTH_URL="http://localhost:3000"

# ─── Email magic link (Resend) — Sprint 1/2 ─────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=""
EMAIL_FROM="DISTRIB <noreply@example.com>"

# ─── AWS S3 + Object Lock COMPLIANCE — Sprint 1 ─────────────────────────────
# Le bucket DOIT être créé avec Object Lock activé dès la création
# (impossible de l'activer rétroactivement). Mode COMPLIANCE, pas GOVERNANCE.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_VAULT=""
S3_OBJECT_LOCK_RETENTION_YEARS="10"

# ─── Polygon / Blockchain — Sprint 3 ────────────────────────────────────────
# alchemy.com → Apps → Polygon (Amoy d'abord, mainnet ensuite)
ALCHEMY_RPC_URL_AMOY=""
ALCHEMY_RPC_URL_MAINNET=""
# Wallet serveur — JAMAIS exposé au client. Provisionner ~20 € MATIC dessus.
SERVER_WALLET_PRIVATE_KEY=""
MASTER_CONTRACT_ADDRESS=""
# Réseau actif : "amoy" (testnet) ou "mainnet".
# NON-NÉGO #3 : ne passer à "mainnet" qu'après 2 semaines de testnet sans anomalie.
POLYGON_NETWORK="amoy"

# ─── Signatures eIDAS (Yousign) — Sprint 2/4 ────────────────────────────────
YOUSIGN_API_KEY=""
YOUSIGN_WEBHOOK_SECRET=""
# Plugin de signature : "local" (cérémonie dans DISTRIB, signature simple) ou
# "yousign" (prestataire eIDAS, requiert YOUSIGN_API_KEY). Niveau demandé :
# SIMPLE | ADVANCED (défaut, §3.2 du mémoire) | QUALIFIED (option à l'acte).
ESIGN_PROVIDER="local"
ESIGN_LEVEL="ADVANCED"

# ─── Reconnaissance audio (AudD) — Sprint 5 ─────────────────────────────────
AUDD_API_TOKEN=""

# ─── Crons (rappels concerts + scan AudD) ────────────────────────────────────
# Générer avec : openssl rand -hex 24. À passer en header :
#   Authorization: Bearer <CRON_SECRET>
# sur GET /api/cron/reminders (1×/jour) et GET /api/cron/scan (1×/jour).
CRON_SECRET=""

# ─── Stockage local (alternative à S3, dev / auto-hébergement) ───────────────
# "local" : fichiers sur le disque (.vault/ par défaut). L'API refuse toujours
# les suppressions, mais l'immuabilité physique n'est garantie qu'avec S3
# Object Lock. La preuve blockchain (hash ancré) fonctionne dans les 2 cas.
# Laisser vide = S3 si configuré, local sinon.
STORAGE_DRIVER=""
VAULT_LOCAL_DIR=""
